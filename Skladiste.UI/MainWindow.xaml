<Window x:Class="Skladiste.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Skladiste.UI.Views"
        Title="Skladiste AS" Height="520" Width="860"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="8">
        <TabItem Header="Proizvodi">
            <views:ProizvodListView DataContext="{Binding ProizvodListViewModel}"/>
        </TabItem>
        <TabItem Header="Kategorije">
            <views:KategorijaListView DataContext="{Binding KategorijaListViewModel}"/>
        </TabItem>
    </TabControl>
</Window>
