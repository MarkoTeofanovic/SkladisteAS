<Window x:Class="Skladiste.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prijava" Height="240" Width="300"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Korisnicko ime"/>
        <TextBox Text="{Binding KorisnickoIme, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Lozinka"/>
        <PasswordBox x:Name="LozinkaPolje" Margin="0,2,0,10"/>

        <Button Content="Prijavi se" Command="{Binding PrijaviSeCommand}"
                CommandParameter="{Binding ElementName=LozinkaPolje}"/>

        <TextBlock Text="{Binding Poruka}" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
